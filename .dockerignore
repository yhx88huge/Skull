# 必须排除：本地 node_modules 是 Windows/macOS 平台二进制，
# 一旦 COPY 进镜像会覆盖容器内 npm ci 装好的 Linux 版本，构建必挂。
node_modules
**/node_modules

# 构建产物（镜像内会重新生成）
**/dist
**/*.tsbuildinfo

# 版本控制与运行时数据
.git
.gitignore
data
**/data

# 本地工具与文档（不影响构建）
.workbuddy
.codeartsdoer
doc
tools
packages/core/vitest-out.txt
*.log

# 本机环境变量
.env
.env.*

# 注意：以下文件必须保留，否则构建/运行会失败
# package.json / package-lock.json / .npmrc / nginx.conf / 各包 src
