{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@skull/core": ["../../packages/core/src/engine.ts"],
      "@skull/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src"]
}